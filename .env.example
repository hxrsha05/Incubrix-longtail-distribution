# Every setting the service reads. Copy to .env and edit. Never commit real secrets.

APP_ENV=dev                      # dev | test | prod
LOG_LEVEL=INFO
SIMULATION_MODE=true             # true = all platforms are mocks, no real accounts needed

# Database (SQLite for tests, Postgres in docker compose)
DATABASE_URL=sqlite:///./data/app.db

# S3-compatible storage (RustFS in docker compose)
S3_ENDPOINT_URL=http://s3:9000
S3_BUCKET=incubrix-distribution
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me

# Signing key for job callbacks (X-IncuBrix-Signature, HMAC-SHA256)
CALLBACK_HMAC_SECRET=change-me

# Certification: test posts must be deleted within this many seconds (brief: 10 minutes)
TEST_POST_TTL_SECONDS=600

JOB_WORKERS=4                    # background job threads
IDEMPOTENCY_PENDING_TIMEOUT_S=120
CALLBACK_MAX_ATTEMPTS=3          # job-finished callback delivery attempts
CALLBACK_BACKOFF_S=0.5

# Build-time only: package index for `docker compose build`. Leave unset for the official PyPI.
# PIP_INDEX_URL=https://pypi.org/simple

# Keys the mock platform server (docker compose) expects. Local fake accounts only.
# MOCK_DISCOURSE_KEY=mock-discourse-key
# MOCK_DEVTO_KEY=mock-devto-key
# MOCK_PARTNER_SECRET=mock-partner-secret

HTTP_TIMEOUT_S=10              # timeout for every call to a platform
DISABLED_CONNECTORS=             # kill switch, e.g. "lemmy,devto" -> those return CONNECTOR_DISABLED

# Certification and evidence
S3_ENABLED=false                 # true = also store evidence in S3 (compose turns it on)
# S3_PUBLIC_URL=http://localhost:9000   # address used in download links
# EVIDENCE_DIR=evidence/certification
# CONNECTIONS_FILE=/seed/connections.json
# MOCK_PLATFORMS_URL=http://mock-platforms:9100
CERTIFY_MAX_CONSECUTIVE_FAILURES=3
CERTIFY_RATE_LIMIT_WAIT_CAP_S=30

# CSV import
IMPORT_WORKERS=32
IMPORT_FETCH_TIMEOUT_S=5
IMPORT_ALLOW_PRIVATE_HOSTS=false   # true only for local demos: lets the importer fetch private addresses (SSRF risk)

# AI rules capture: mock = offline keyword reader (default, no key, no cost); anthropic = Claude
RULES_EXTRACTOR=mock
# ANTHROPIC_API_KEY=
# RULES_MODEL=claude-haiku-5-5
# RULES_PRICE_PER_MTOK_IN=0
# RULES_PRICE_PER_MTOK_OUT=0

# MRSS feed host (this service)
SERVICE_BASE_URL=http://localhost:8000   # the address partners use to reach this service (used in feed links)
FEED_TOKEN=local-dev-feed-token          # lets a client add and remove feed items; reading a feed needs no token
FEED_MAX_ITEMS=50

# Recertification (0 = scheduler off; POST /api/v1/recertify still works by hand)
RECERT_INTERVAL_S=0
RECERT_MAX_AGE_S=604800
RECERT_DEMOTED_COOLDOWN_S=86400
RECERT_ATTENTION_RETRY_S=3600
RECERT_BATCH_LIMIT=25

# Public demo protection (leave empty locally)
# API_TOKEN=choose-a-long-random-token
RATE_LIMIT_PER_MINUTE=0
TRUST_PROXY=false
# ALERT_WEBHOOK_URL=
# MOCK_CONTROL_TOKEN=
